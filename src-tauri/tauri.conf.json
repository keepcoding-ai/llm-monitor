{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LLM Monitor",
  "version": "0.1.0",
  "identifier": "studio.codr.llm-monitor",
  "build": {
    "frontendDist": "loading"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LLM Monitor",
        "width": 1280,
        "height": 860,
        "minWidth": 380,
        "minHeight": 600,
        "url": "index.html"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
