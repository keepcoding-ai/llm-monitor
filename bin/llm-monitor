#!/usr/bin/env bash
# llm-monitor — sobe, consulta e para o LLM Monitor (espelha a skill llm-monitor).
# LLM_MONITOR_DIR so existe para teste; o padrao e fixo.
APP_DIR="${LLM_MONITOR_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
RUN_DIR="/c/atrium/.tmp/llm-monitor"
PID_FILE="$RUN_DIR/run.pid"
PORT="${LLM_MONITOR_PORT:-4780}"
URL="http://localhost:$PORT/llm-monitor/"

http_code() { curl -s -o /dev/null -m 3 -w "%{http_code}" "$URL" 2>/dev/null; }

# PIDs que escutam a porta $1
port_pids() {
  netstat -ano 2>/dev/null | tr -d '\r' \
    | awk -v p=":$1" '$1=="TCP" && $2 ~ p"$" && $4=="LISTENING" {print $5}' | sort -u
}

cmdline_of() {
  powershell.exe -NoProfile -Command "(Get-CimInstance Win32_Process -Filter \"ProcessId=$1\").CommandLine" 2>/dev/null | tr -d '\r'
}

# true se $1 e o node do llm-monitor servido: a linha de comando precisa ter
# dist-server/index.mjs dentro da pasta do app (vale para o PID do run.pid tambem:
# protege contra PID reaproveitado).
is_ours() {
  local cl; cl="$(cmdline_of "$1")"
  [ -z "$cl" ] && return 1
  local w m; w="$(cygpath -w "$APP_DIR" 2>/dev/null)"; m="$(cygpath -m "$APP_DIR" 2>/dev/null)"
  echo "$cl" | grep -qiF "dist-server" || return 1
  echo "$cl" | grep -qiF -e "$w" -e "$m" -e "$APP_DIR"
}

# true se precisa buildar: dist/ ou dist-server/ ausentes ou mais velhos que src/ ou server/
needs_build() {
  local d
  for d in dist/index.html dist-server/index.mjs; do [ -f "$APP_DIR/$d" ] || return 0; done
  local newest_src; newest_src="$(find "$APP_DIR/src" "$APP_DIR/server" -type f -newer "$APP_DIR/dist-server/index.mjs" 2>/dev/null | head -1)"
  [ -n "$newest_src" ] && return 0
  newest_src="$(find "$APP_DIR/src" "$APP_DIR/server" -type f -newer "$APP_DIR/dist/index.html" 2>/dev/null | head -1)"
  [ -n "$newest_src" ]
}

# abre o navegador sem herdar o console (cmd /c start segura o terminal)
open_browser() {
  [ "$NO_OPEN" = "1" ] && return 0
  powershell.exe -NoProfile -Command "Start-Process '$URL'" </dev/null >/dev/null 2>&1 &
  disown 2>/dev/null
  return 0
}

print_pids() {
  echo "PIDs: port($PORT)=$(port_pids $PORT | paste -sd' ' -)"
}

cmd_help() {
  cat <<H
llm-monitor - launch and manage the LLM Monitor

Usage:
  llm-monitor          start the app (if not running) and open it in the browser
  llm-monitor --no-open  start the app without opening the browser
  llm-monitor status   tell whether it is up and who owns port $PORT
  llm-monitor stop     stop it (only processes that belong to llm-monitor)
  llm-monitor help     this text

Address: $URL
H
}

cmd_status() {
  local c; c="$(http_code)"
  if [ "$c" = "200" ]; then echo "llm-monitor: UP at $URL"; else echo "llm-monitor: DOWN (http $c)"; fi
  print_pids
  [ -f "$PID_FILE" ] && echo "run.pid: $(cat "$PID_FILE")"
  [ "$c" = "200" ]
}

cmd_stop() {
  local pids="" p
  [ -f "$PID_FILE" ] && pids="$(cat "$PID_FILE" | tr -d '\r\n ')|1"
  local list=""
  [ -n "$pids" ] && list="$pids"
  for p in $(port_pids $PORT); do list="$list $p|0"; done
  [ -z "$list" ] && { echo "nothing to stop"; return 0; }
  local seen=" " item pid flag victims=""
  # 1a passada: decide tudo antes de matar (matar o lancador apaga a ancestralidade dos filhos)
  for item in $list; do
    pid="${item%%|*}"; flag="${item##*|}"
    case "$seen" in *" $pid "*) continue;; esac
    seen="$seen$pid "
    if is_ours "$pid"; then victims="$victims $pid"
    else echo "PID $pid does not look like llm-monitor - NOT touching it"; fi
  done
  # 2a passada: kill por PID, com arvore
  for pid in $victims; do
    if [ "$DRY_RUN" = "1" ]; then echo "[dry-run] would stop PID $pid (belongs to llm-monitor)"
    else taskkill //PID "$pid" //T //F >/dev/null 2>&1 && echo "stopped PID $pid" || echo "PID $pid already gone"; fi
  done
  [ "$DRY_RUN" = "1" ] || rm -f "$PID_FILE"
}

cmd_start() {
  if [ ! -f "$APP_DIR/package.json" ]; then
    cat <<R
llm-monitor is not installed on this machine ($APP_DIR).

Prerequisites: clone the atrium (workspace/atrium) and commons (workspace/commons) repos
first (file: dependencies), and add a statusLine entry to ~/.claude/settings.json:
  node C:/atrium/workspace/llm-monitor/statusline.mjs

Then, one command at a time (Git Bash):
  gh auth status
  git clone git@github.com:keepcoding-ai/llm-monitor.git /c/atrium/workspace/llm-monitor
  cd /c/atrium/workspace/llm-monitor
  npm install
R
    return 1
  fi
  if [ ! -d "$APP_DIR/node_modules" ]; then
    echo "installing dependencies..."
    (cd "$APP_DIR" && npm install) || { echo "npm install failed"; return 1; }
  fi
  if [ "$(http_code)" = "200" ]; then
    echo "llm-monitor already running: $URL"
    print_pids
    open_browser
    return 0
  fi
  if [ -n "$(port_pids $PORT)" ]; then
    echo "port $PORT is in use but not answering as llm-monitor."
    print_pids
    echo "Not killing anything. Check with: llm-monitor status"
    return 1
  fi
  mkdir -p "$RUN_DIR"
  if needs_build; then
    echo "building (dist/ missing or older than sources)..."
    (cd "$APP_DIR" && npm run build) || { echo "build failed"; return 1; }
  fi
  local winpath; winpath="$(cygpath -w "$APP_DIR")"
  local pid
  pid="$(LLM_MONITOR_PORT="$PORT" WSLENV= powershell.exe -NoProfile -Command "\$p = Start-Process -FilePath node -ArgumentList '--max-old-space-size=96','--max-semi-space-size=1','$winpath\dist-server\index.mjs' -WorkingDirectory '$winpath' -WindowStyle Hidden -PassThru; \$p.Id" | tr -d '\r\n ')"
  [ -z "$pid" ] && { echo "failed to launch"; return 1; }
  echo "$pid" > "$PID_FILE"
  echo "launching (PID $pid), waiting for $URL ..."
  local i
  for i in $(seq 1 60); do
    [ "$(http_code)" = "200" ] && break
    sleep 1
  done
  if [ "$(http_code)" = "200" ]; then
    echo "llm-monitor up: $URL (launcher PID $pid)"
    print_pids
    open_browser
  else
    echo "timeout: not answering after 60s (launcher PID $pid)"; return 1
  fi
}

case "${1:-}" in
  "")      cmd_start ;;
  --no-open) NO_OPEN=1; cmd_start ;;
  status)  cmd_status ;;
  stop)    cmd_stop ;;
  help|-h|--help) cmd_help ;;
  __check) is_ours "$2" && echo "PID $2: ours (would stop)" || echo "PID $2: NOT ours (would refuse)" ;;
  *) echo "unknown command: $1"; cmd_help; exit 2 ;;
esac
